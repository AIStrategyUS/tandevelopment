---
import logoFullRaw from '../assets/logo-full.svg?raw';

const year = new Date().getFullYear();

const links = [
  { href: '/portfolio/', label: 'Portfolio' },
  { href: '/process/', label: 'Process' },
  { href: '/about/', label: 'About' },
  { href: '/contact/', label: 'Contact' },
];

const phoneDisplay = '574-870-6947';
const phoneHref = 'tel:+15748706947';
const availableHomesUrl = 'https://www.carletelloandco.com/properties/sale';
const instagramUrl = 'https://www.instagram.com/sebastian_tan01/';
---

<footer class="footer">
  <div class="wrap footer__main">
    <div class="footer__brand">
      <a href="/" class="footer__logo" aria-label="Tan Development, home">
        <Fragment set:html={logoFullRaw} />
      </a>
      <p class="footer__tagline">We build homes in Nashville, built with care and made to last.</p>
      <a href={instagramUrl} target="_blank" rel="noopener" class="footer__link footer__instagram">
        Instagram
      </a>
    </div>

    <div class="footer__col">
      <h2 class="footer__heading">Navigation</h2>
      <ul class="footer__list">
        {links.map((link) => (
          <li><a href={link.href} class="footer__link">{link.label}</a></li>
        ))}
      </ul>
    </div>

    <div class="footer__col">
      <h2 class="footer__heading">Contact</h2>
      <ul class="footer__list">
        <li><a href={phoneHref} class="footer__link">{phoneDisplay}</a></li>
        <li class="footer__static">Nashville, Tennessee</li>
        <li>
          <a href={availableHomesUrl} target="_blank" rel="noopener" class="footer__link">
            Available Homes
          </a>
        </li>
      </ul>
    </div>
  </div>

  <div class="wrap footer__bottom">
    <p>&copy; {year} Tan Development. All rights reserved.</p>
    <p>Nashville, Tennessee</p>
  </div>
</footer>

<style>
  .footer {
    background: var(--color-ink);
    color: var(--color-text-on-dark-muted);
  }

  .footer__main {
    padding-block: clamp(48px, 6vw, 80px);
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr;
    gap: clamp(32px, 6vw, 80px);
  }

  .footer__brand {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 18px;
  }

  .footer__logo {
    color: var(--color-text-on-dark);
  }

  .footer__logo :global(svg) {
    height: 40px;
    width: auto;
    display: block;
  }

  .footer__tagline {
    max-width: 30ch;
    font-size: 0.875rem;
    line-height: 1.7;
    color: var(--color-text-on-dark-muted);
  }

  .footer__heading {
    font-family: var(--font-body);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin-bottom: 20px;
  }

  .footer__list {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .footer__link,
  .footer__static {
    font-size: 0.875rem;
    color: var(--color-text-on-dark-muted);
  }

  .footer__link {
    transition: color 0.2s ease;
  }

  @media (prefers-reduced-motion: reduce) {
    .footer__link {
      transition: none;
    }
  }

  .footer__link:hover {
    color: var(--color-text-on-dark);
  }

  .footer__bottom {
    padding-block: 22px;
    border-top: 1px solid var(--color-border-dark);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
  }

  .footer__bottom p {
    font-size: 0.75rem;
    color: var(--color-text-on-dark-muted);
  }

  @media (max-width: 720px) {
    .footer__main {
      grid-template-columns: 1fr;
    }

    .footer__bottom {
      flex-direction: column;
      align-items: flex-start;
      gap: 6px;
    }
  }
</style>
