---
// /process/ - how a Tan Development custom home moves from land to keys.
// Follows the shared design system: Layout wraps the page, tokens come
// from global.css, and .fade-up opts elements into the shared scroll
// reveal (Layout calls reveal.js's init() once per page automatically).
import Layout from '../../layouts/Layout.astro';

interface Stage {
  number: string;
  title: string;
  description: string;
  bullets: string[];
  photo?: { src: string; alt: string; width: number; height: number; caption: string };
}

const stages: Stage[] = [
  {
    number: '01',
    title: 'Site Sourcing & Due Diligence',
    description:
      'Every project starts with the land. We evaluate zoning, feasibility, environmental and title conditions, and comparable sales in the area before we make an offer, so the numbers work before anything else moves forward.',
    bullets: [
      'Site identification and market analysis',
      'Zoning, easement, and title review',
      'Environmental and soil assessment',
      'Comparable sales and feasibility modeling',
      'Offer structured and land under contract',
    ],
  },
  {
    number: '02',
    title: 'Entitlement & Design',
    description:
      'Once we control the site, we bring in the architect and engineers to shape a design that fits the lot and the market, and take it through permitting and any variances the property needs.',
    bullets: [
      'Architectural design and engineering',
      'Permitting and zoning approval',
      'Variance and easement resolution',
      'Utility and site plan coordination',
      'Final plans priced and locked',
    ],
    photo: {
      src: '/images/projects/3827-edwards/hero-1600x1066.jpg',
      alt: 'Design rendering of an in-progress Tan Development home on Edwards Avenue',
      width: 1600,
      height: 1066,
      caption: 'A design rendering from one of our current Edwards Avenue projects.',
    },
  },
  {
    number: '03',
    title: 'Capital & Structuring',
    description:
      'Before construction starts, we lock the budget, structure financing, and bring in capital partners on projects where that makes sense. Every number is settled ahead of time, not renegotiated mid-build.',
    bullets: [
      'Construction budget finalized',
      'Financing structured',
      'Capital partners brought in where applicable',
      'Contracts and draw schedule set',
      'Subcontractors and suppliers under contract',
    ],
  },
  {
    number: '04',
    title: 'Construction Oversight',
    description:
      'We manage the build day to day: framing through finish work, trade coordination, and milestone walkthroughs, so the budget and schedule hold and the quality matches what we underwrote.',
    bullets: [
      'Foundation, framing, and mechanicals',
      'Trade coordination and quality control',
      'Milestone walkthroughs and inspections',
      'Budget and schedule tracked against plan',
      'Interior finishes, cabinetry, and trim',
    ],
    photo: {
      src: '/images/projects/3829-edwards/gallery-2-1600x1318.jpg',
      alt: 'Design rendering of a kitchen with dark stained cabinetry and a plaster-finish range hood',
      width: 1600,
      height: 1318,
      caption: 'Interior finish rendering from an Edwards Avenue project currently in design.',
    },
  },
  {
    number: '05',
    title: 'Delivery',
    description:
      'The last stage is about closing it out right: final inspections, the punch list, and handoff, whether that means keys to a homeowner or closing out with a capital partner.',
    bullets: [
      'Final inspections and certificate of occupancy',
      'Punch list walkthrough',
      'Final cleaning and touch-ups',
      'Homeowner or buyer walkthrough',
      'Keys, closing, and reporting to partners',
    ],
  },
];

const workingWith = [
  {
    title: 'Communication',
    body: 'You hear from us at every stage change, on the deal and the build alike, not just when something goes wrong. Expect real updates, a point of contact who answers the phone, and plain language, not real estate jargon.',
  },
  {
    title: 'Design Partnerships',
    body: 'We work with professional architects and designers on every project, not in-house guesswork. Material and finish decisions get made in dedicated design meetings, priced and locked before they can hold up a trade or a draw.',
  },
  {
    title: 'Timeline & Capital',
    body: 'Every project moves through the same five stages, but the pace depends on the site, the entitlement process, and how a deal is financed. We build a realistic schedule once the land is under contract and keep partners and clients updated as it holds.',
  },
];
---

<Layout
  title="Process | Tan Development"
  description="How Tan Development moves a Nashville real estate project from site sourcing and due diligence through entitlement, capital, construction, and delivery."
  canonicalPath="/process/"
>
  <section class="page-hero">
    <div class="wrap page-hero__inner">
      <p class="page-hero__eyebrow fade-up">Process</p>
      <h1 class="page-hero__title fade-up">From Site to Delivery</h1>
      <p class="page-hero__intro fade-up">
        We break every project into five stages, from the first site evaluation to the final closing.
        Here is what actually happens at each one.
      </p>
    </div>
  </section>

  <section class="stages">
    <div class="wrap">
      {stages.map((stage) => (
        <Fragment>
          <article class="stage fade-up">
            <div class="stage__number" aria-hidden="true">{stage.number}</div>
            <div class="stage__content">
              <h2 class="stage__title">{stage.title}</h2>
              <p class="stage__description">{stage.description}</p>
              <ul class="stage__list">
                {stage.bullets.map((bullet) => (
                  <li>{bullet}</li>
                ))}
              </ul>
            </div>
          </article>

          {stage.photo && (
            <div class="stage__photo fade-up">
              <img
                src={stage.photo.src}
                alt={stage.photo.alt}
                width={stage.photo.width}
                height={stage.photo.height}
                loading="lazy"
              />
              <p class="stage__photo-caption">{stage.photo.caption}</p>
            </div>
          )}
        </Fragment>
      ))}
    </div>
  </section>

  <section class="working-with">
    <div class="wrap">
      <h2 class="working-with__heading fade-up">Working with Tan Development</h2>
      <div class="working-with__grid">
        {workingWith.map((item) => (
          <div class="working-with__item fade-up">
            <h3 class="working-with__title">{item.title}</h3>
            <p class="working-with__body">{item.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
</Layout>

<style>
  /* ---------------------------------------------------------------- */
  /* Hero                                                              */
  /* ---------------------------------------------------------------- */
  .page-hero {
    background: var(--color-ink);
    color: var(--color-text-on-dark);
  }

  .page-hero__inner {
    padding-top: clamp(160px, 22vw, 220px);
    padding-bottom: clamp(56px, 8vw, 96px);
  }

  .page-hero__eyebrow {
    font-family: var(--font-body);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin-bottom: 18px;
  }

  .page-hero__title {
    color: var(--color-text-on-dark);
    max-width: 14ch;
  }

  .page-hero__intro {
    margin-top: 24px;
    max-width: var(--max-width-text);
    font-size: 1.0625rem;
    line-height: 1.7;
    color: var(--color-text-on-dark-muted);
  }

  /* ---------------------------------------------------------------- */
  /* Stages                                                            */
  /* ---------------------------------------------------------------- */
  .stages {
    padding-block: var(--space-section);
  }

  .stage {
    display: grid;
    grid-template-columns: 140px 1fr;
    gap: clamp(24px, 5vw, 64px);
    padding-block: clamp(40px, 6vw, 64px);
    border-top: 1px solid var(--color-border);
  }

  .stage:first-child {
    border-top: none;
    padding-top: 0;
  }

  .stage__number {
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 2rem + 2vw, 4rem);
    font-weight: 500;
    line-height: 1;
    color: var(--color-accent);
  }

  .stage__content {
    max-width: 760px;
  }

  .stage__title {
    margin-bottom: 16px;
  }

  .stage__description {
    max-width: var(--max-width-text);
    font-size: 1.0625rem;
  }

  .stage__list {
    margin-top: 24px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    max-width: var(--max-width-text);
  }

  .stage__list li {
    position: relative;
    padding-left: 22px;
    font-size: 0.9375rem;
    color: var(--color-text-muted);
    line-height: 1.6;
  }

  .stage__list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.6em;
    width: 6px;
    height: 6px;
    background: var(--color-accent);
    border-radius: 50%;
  }

  .stage__photo {
    margin: clamp(8px, 2vw, 16px) 0 clamp(24px, 4vw, 40px);
    margin-left: calc(140px + clamp(24px, 5vw, 64px));
    background: var(--color-bg-alt);
    overflow: hidden;
  }

  .stage__photo img {
    width: 100%;
    height: auto;
    display: block;
  }

  .stage__photo-caption {
    margin-top: 10px;
    font-size: 0.8125rem;
    color: var(--color-text-muted);
  }

  @media (max-width: 720px) {
    .stage {
      grid-template-columns: 1fr;
      gap: 16px;
    }

    .stage__photo {
      margin-left: 0;
    }
  }

  /* ---------------------------------------------------------------- */
  /* Working with Tan Development                                      */
  /* ---------------------------------------------------------------- */
  .working-with {
    background: var(--color-bg-alt);
    padding-block: var(--space-section);
  }

  .working-with__heading {
    max-width: 20ch;
    margin-bottom: clamp(32px, 5vw, 56px);
  }

  .working-with__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(32px, 5vw, 56px);
  }

  .working-with__title {
    margin-bottom: 12px;
  }

  .working-with__body {
    font-size: 0.9375rem;
  }

  @media (max-width: 860px) {
    .working-with__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
