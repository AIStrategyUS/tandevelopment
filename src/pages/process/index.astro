---
// /process/ - how a Tan Development custom home moves from land to keys.
// Follows the shared design system: Layout wraps the page, tokens come
// from global.css, and .fade-up opts elements into the shared scroll
// reveal (Layout calls reveal.js's init() once per page automatically).
import Layout from '../../layouts/Layout.astro';

interface Stage {
  number: string;
  title: string;
  description: string;
  bullets: string[];
  photo?: { src: string; alt: string; width: number; height: number; caption: string };
}

const stages: Stage[] = [
  {
    number: '01',
    title: 'Land & Design',
    description:
      'Every build starts with the lot. We walk the site, check the survey, and work with the architect on a floor plan that fits the way you actually live. Nothing moves to pre-construction until the design is priced and everyone agrees on the plan.',
    bullets: [
      'Lot evaluation and feasibility review',
      'Site survey and soil testing',
      'Architectural plans and elevations',
      'Zoning, setback, and easement review',
      'Design finalized and priced',
    ],
    photo: {
      src: '/images/projects/3827-edwards/hero-1600x1066.jpg',
      alt: 'Design rendering of an in-progress Tan Development home on Edwards Avenue',
      width: 1600,
      height: 1066,
      caption: 'A design rendering from one of our current Edwards Avenue projects.',
    },
  },
  {
    number: '02',
    title: 'Pre-Construction',
    description:
      'This is where the plan becomes a schedule. We pull permits, lock the budget and specifications, and line up the subcontractors and suppliers the build depends on. By the time the first shovel goes in the ground, there should be no surprises left in the paperwork.',
    bullets: [
      'Permitting submitted and pulled',
      'Budget and specifications finalized',
      'Subcontractors and suppliers scheduled',
      'Site prep and utility connections arranged',
      'Pre-construction meeting with the client',
    ],
  },
  {
    number: '03',
    title: 'Build',
    description:
      'Foundation, framing, and every trade in between happen in this stage, usually the longest of the four. We walk the site at key milestones, including a framing walkthrough with the client, so you can see the house take shape before the walls close up.',
    bullets: [
      'Foundation and framing',
      'Rough mechanical, electrical, and plumbing',
      'Framing walkthrough with the client',
      'Exterior envelope, windows, and roofing',
      'Interior finishes, cabinetry, and trim',
    ],
    photo: {
      src: '/images/projects/3829-edwards/gallery-2-1600x1318.jpg',
      alt: 'Design rendering of a kitchen with dark stained cabinetry and a plaster-finish range hood',
      width: 1600,
      height: 1318,
      caption: 'Interior finish rendering from an Edwards Avenue project currently in design.',
    },
  },
  {
    number: '04',
    title: 'Delivery',
    description:
      'The last stage is about details. We run final inspections, walk the punch list room by room, and clean the house top to bottom before handing over the keys. A home is not finished until it is finished right.',
    bullets: [
      'Final inspections and certificate of occupancy',
      'Punch list walkthrough',
      'Final cleaning and touch-ups',
      'Homeowner orientation walkthrough',
      'Keys and closing',
    ],
  },
];

const workingWith = [
  {
    title: 'Communication',
    body: 'You will hear from us at every stage change, not just when something goes wrong. Expect site photos, a point of contact who answers the phone, and updates in plain language, not builder jargon.',
  },
  {
    title: 'Selections',
    body: 'Material and finish choices happen in dedicated selections meetings, not at the counter of a showroom under a deadline. We walk through cabinetry, countertops, flooring, fixtures, and paint together, and lock decisions in before they can hold up a trade.',
  },
  {
    title: 'Timeline Expectations',
    body: 'Every custom home moves through the same four stages, but the pace depends on the lot, the design, and the season. We build a realistic schedule at the start of pre-construction and keep it updated as decisions are made, so you always know where the build stands.',
  },
];
---

<Layout
  title="Process | Tan Development"
  description="How Tan Development builds a custom home in Nashville, from land and design through pre-construction, the build, and delivery."
  canonicalPath="/process/"
>
  <section class="page-hero">
    <div class="wrap page-hero__inner">
      <p class="page-hero__eyebrow fade-up">Process</p>
      <h1 class="page-hero__title fade-up">How We Build</h1>
      <p class="page-hero__intro fade-up">
        We break every custom home into four stages, from the first site walk to the day we hand you the keys.
        Here is what actually happens at each one.
      </p>
    </div>
  </section>

  <section class="stages">
    <div class="wrap">
      {stages.map((stage) => (
        <Fragment>
          <article class="stage fade-up">
            <div class="stage__number" aria-hidden="true">{stage.number}</div>
            <div class="stage__content">
              <h2 class="stage__title">{stage.title}</h2>
              <p class="stage__description">{stage.description}</p>
              <ul class="stage__list">
                {stage.bullets.map((bullet) => (
                  <li>{bullet}</li>
                ))}
              </ul>
            </div>
          </article>

          {stage.photo && (
            <div class="stage__photo fade-up">
              <img
                src={stage.photo.src}
                alt={stage.photo.alt}
                width={stage.photo.width}
                height={stage.photo.height}
                loading="lazy"
              />
              <p class="stage__photo-caption">{stage.photo.caption}</p>
            </div>
          )}
        </Fragment>
      ))}
    </div>
  </section>

  <section class="working-with">
    <div class="wrap">
      <h2 class="working-with__heading fade-up">Working with Tan Development</h2>
      <div class="working-with__grid">
        {workingWith.map((item) => (
          <div class="working-with__item fade-up">
            <h3 class="working-with__title">{item.title}</h3>
            <p class="working-with__body">{item.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
</Layout>

<style>
  /* ---------------------------------------------------------------- */
  /* Hero                                                              */
  /* ---------------------------------------------------------------- */
  .page-hero {
    background: var(--color-ink);
    color: var(--color-text-on-dark);
  }

  .page-hero__inner {
    padding-top: clamp(160px, 22vw, 220px);
    padding-bottom: clamp(56px, 8vw, 96px);
  }

  .page-hero__eyebrow {
    font-family: var(--font-body);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin-bottom: 18px;
  }

  .page-hero__title {
    color: var(--color-text-on-dark);
    max-width: 14ch;
  }

  .page-hero__intro {
    margin-top: 24px;
    max-width: var(--max-width-text);
    font-size: 1.0625rem;
    line-height: 1.7;
    color: var(--color-text-on-dark-muted);
  }

  /* ---------------------------------------------------------------- */
  /* Stages                                                            */
  /* ---------------------------------------------------------------- */
  .stages {
    padding-block: var(--space-section);
  }

  .stage {
    display: grid;
    grid-template-columns: 140px 1fr;
    gap: clamp(24px, 5vw, 64px);
    padding-block: clamp(40px, 6vw, 64px);
    border-top: 1px solid var(--color-border);
  }

  .stage:first-child {
    border-top: none;
    padding-top: 0;
  }

  .stage__number {
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 2rem + 2vw, 4rem);
    font-weight: 500;
    line-height: 1;
    color: var(--color-accent);
  }

  .stage__content {
    max-width: 760px;
  }

  .stage__title {
    margin-bottom: 16px;
  }

  .stage__description {
    max-width: var(--max-width-text);
    font-size: 1.0625rem;
  }

  .stage__list {
    margin-top: 24px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    max-width: var(--max-width-text);
  }

  .stage__list li {
    position: relative;
    padding-left: 22px;
    font-size: 0.9375rem;
    color: var(--color-text-muted);
    line-height: 1.6;
  }

  .stage__list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.6em;
    width: 6px;
    height: 6px;
    background: var(--color-accent);
    border-radius: 50%;
  }

  .stage__photo {
    margin: clamp(8px, 2vw, 16px) 0 clamp(24px, 4vw, 40px);
    margin-left: calc(140px + clamp(24px, 5vw, 64px));
    background: var(--color-bg-alt);
    overflow: hidden;
  }

  .stage__photo img {
    width: 100%;
    height: auto;
    display: block;
  }

  .stage__photo-caption {
    margin-top: 10px;
    font-size: 0.8125rem;
    color: var(--color-text-muted);
  }

  @media (max-width: 720px) {
    .stage {
      grid-template-columns: 1fr;
      gap: 16px;
    }

    .stage__photo {
      margin-left: 0;
    }
  }

  /* ---------------------------------------------------------------- */
  /* Working with Tan Development                                      */
  /* ---------------------------------------------------------------- */
  .working-with {
    background: var(--color-bg-alt);
    padding-block: var(--space-section);
  }

  .working-with__heading {
    max-width: 20ch;
    margin-bottom: clamp(32px, 5vw, 56px);
  }

  .working-with__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(32px, 5vw, 56px);
  }

  .working-with__title {
    margin-bottom: 12px;
  }

  .working-with__body {
    font-size: 0.9375rem;
  }

  @media (max-width: 860px) {
    .working-with__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
