---
// /about/ - Sebastian Tan, Founder & Principal of Tan Development.
// Follows the shared design system: Layout wraps the page, tokens come
// from global.css, and .fade-up opts elements into the shared scroll
// reveal (Layout calls reveal.js's init() once per page automatically).
import Layout from '../../layouts/Layout.astro';

const carletelloUrl = 'https://carletelloandco.com/';
const carletelloPhoneDisplay = '(615) 405-7422';
const carletelloPhoneHref = 'tel:+16154057422';
const instagramUrl = 'https://www.instagram.com/sebastian_tan01/';

const expertise = [
  {
    title: 'Site & Land Acquisition',
    body: 'We source land directly and through relationships across Nashville, and move fast when the numbers work.',
  },
  {
    title: 'Due Diligence & Feasibility',
    body: 'Zoning, title, environmental, and comparable sales get reviewed before we ever make an offer.',
  },
  {
    title: 'Design & Entitlement',
    body: 'We work with architects and engineers to shape a plan that fits the site, then take it through permitting and any approvals it needs.',
  },
  {
    title: 'Capital & Investor Relations',
    body: 'We structure financing and bring in capital partners on select projects, with clear terms and regular reporting.',
  },
  {
    title: 'Budget & Construction Oversight',
    body: 'Specifications get priced and locked before we break ground, and we stay on site through every milestone to keep the build on plan.',
  },
  {
    title: 'Client & Partner Communication',
    body: 'You hear from us at every stage change, on the deal and the build alike, in plain language.',
  },
];
---

<Layout
  title="About | Tan Development"
  description="Meet Sebastian Tan, Founder and Principal of Tan Development, a Nashville real estate development company."
  canonicalPath="/about/"
>
  <section class="page-hero">
    <div class="wrap page-hero__inner">
      <p class="page-hero__eyebrow fade-up">About</p>
      <h1 class="page-hero__title fade-up">Sebastian Tan</h1>
      <p class="page-hero__subhead fade-up">Founder & Principal, Tan Development</p>
    </div>
  </section>

  <section class="about-intro">
    <div class="wrap about-intro__grid">
      <div class="about-intro__portrait fade-up">
        <img
          src="/images/about/sebastian-tan-1145x1374.jpg"
          alt="Sebastian Tan, Founder and Principal of Tan Development, in the company office"
          width="1145"
          height="1374"
          loading="lazy"
        />
      </div>

      <div class="about-intro__text">
        <p class="fade-up">
          Sebastian Tan founded Tan Development to find real estate opportunities that make sense on paper and
          build them the right way. He runs the due diligence himself, zoning, feasibility, comparable sales,
          before any offer is signed. Once a deal is underway, he brings in the same architects, designers, and
          trade partners project after project, because consistent quality comes from working with people who
          already know the standard.
        </p>
        <p class="fade-up">
          Nashville is where Sebastian chose to build his business. Between the older neighborhoods, the mix of
          craftsman bungalows and new construction, and a city still figuring out what it wants to look like
          next, there is real opportunity for a developer who does the homework before making an offer.
        </p>
        <p class="fade-up">
          What matters to Sebastian is simple: numbers that hold up, a design that fits the site, and a build
          that matches what was underwritten. He believes a good partner experience starts with a developer who
          tells you the truth about the deal, keeps the budget honest, and finishes what he starts.
        </p>
      </div>
    </div>
  </section>

  <section class="pull-quote-section">
    <div class="wrap">
      <blockquote class="pull-quote fade-up">
        <p>&ldquo;I would rather pass on ten deals than get the numbers wrong on one.&rdquo;</p>
        <cite class="pull-quote__attribution">Sebastian Tan</cite>
      </blockquote>
    </div>
  </section>

  <section class="expertise">
    <div class="wrap">
      <p class="kicker fade-up">What We Do Best</p>
      <h2 class="fade-up">Areas of Expertise</h2>

      <div class="expertise-grid">
        {expertise.map((item) => (
          <div class="expertise-item fade-up">
            <h3 class="expertise-item__title">{item.title}</h3>
            <p class="expertise-item__body">{item.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="partners">
    <div class="wrap partners__grid">
      <div class="partners__block fade-up">
        <h2 class="partners__heading">Our Partners</h2>
        <p class="partners__body">
          Every Tan Development home for sale is listed and shown by Carletello &amp; Co. Tony Carletello,
          Principal Agent, and his team handle showings, offers, and closing, so we can stay focused on the
          next deal.
        </p>
        <div class="partners__meta">
          <a href={carletelloUrl} target="_blank" rel="noopener" class="partners__link">Carletello &amp; Co.</a>
          <a href={carletelloPhoneHref} class="partners__link">{carletelloPhoneDisplay}</a>
        </div>
      </div>

      <div class="partners__block fade-up">
        <h2 class="partners__heading">Follow the Build</h2>
        <p class="partners__body">
          See more of our work in progress, from framing to final finishes, on Instagram.
        </p>
        <div class="partners__meta">
          <a href={instagramUrl} target="_blank" rel="noopener" class="partners__link">@sebastian_tan01</a>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* ---------------------------------------------------------------- */
  /* Hero                                                              */
  /* ---------------------------------------------------------------- */
  .page-hero {
    background: var(--color-ink);
    color: var(--color-text-on-dark);
  }

  .page-hero__inner {
    padding-top: clamp(160px, 22vw, 220px);
    padding-bottom: clamp(56px, 8vw, 96px);
  }

  .page-hero__eyebrow {
    font-family: var(--font-body);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin-bottom: 18px;
  }

  .page-hero__title {
    color: var(--color-text-on-dark);
  }

  .page-hero__subhead {
    margin-top: 20px;
    font-size: 1.0625rem;
    color: var(--color-text-on-dark-muted);
  }

  /* ---------------------------------------------------------------- */
  /* Intro: portrait + bio                                             */
  /* ---------------------------------------------------------------- */
  .about-intro {
    padding-block: var(--space-section);
  }

  .about-intro__grid {
    display: grid;
    grid-template-columns: minmax(240px, 360px) 1fr;
    gap: clamp(32px, 6vw, 80px);
    align-items: start;
  }

  .about-intro__portrait {
    background: var(--color-bg-alt);
    overflow: hidden;
  }

  .about-intro__portrait img {
    width: 100%;
    height: auto;
    display: block;
  }

  .about-intro__text {
    display: flex;
    flex-direction: column;
    gap: 22px;
    max-width: var(--max-width-text);
  }

  .about-intro__text p {
    font-size: 1.0625rem;
  }

  @media (max-width: 860px) {
    .about-intro__grid {
      grid-template-columns: 1fr;
    }

    .about-intro__portrait {
      max-width: 360px;
    }
  }

  /* ---------------------------------------------------------------- */
  /* Pull quote                                                        */
  /* ---------------------------------------------------------------- */
  .pull-quote-section {
    background: var(--color-bg-alt);
    padding-block: clamp(64px, 8vw, 112px);
  }

  .pull-quote {
    max-width: 800px;
    margin-inline: auto;
    text-align: center;
  }

  .pull-quote p {
    font-family: var(--font-display);
    font-size: clamp(1.625rem, 1.3rem + 1.4vw, 2.375rem);
    font-weight: 400;
    line-height: 1.35;
    color: var(--color-ink);
  }

  .pull-quote__attribution {
    display: block;
    margin-top: 20px;
    font-style: normal;
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  /* ---------------------------------------------------------------- */
  /* Areas of Expertise                                                */
  /* ---------------------------------------------------------------- */
  .kicker {
    font-family: var(--font-body);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin-bottom: 14px;
  }

  .expertise {
    background: var(--color-ink);
    color: var(--color-text-on-dark);
    padding-block: var(--space-section);
  }

  .expertise h2 {
    color: var(--color-text-on-dark);
    max-width: 20ch;
  }

  .expertise-grid {
    margin-top: clamp(32px, 5vw, 56px);
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(24px, 3vw, 40px);
  }

  .expertise-item {
    border-left: 2px solid var(--color-accent);
    padding-left: 20px;
  }

  .expertise-item__title {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 500;
    color: var(--color-text-on-dark);
    margin-bottom: 10px;
  }

  .expertise-item__body {
    font-size: 0.9375rem;
    line-height: 1.7;
    color: var(--color-text-on-dark-muted);
  }

  @media (max-width: 860px) {
    .expertise-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 560px) {
    .expertise-grid {
      grid-template-columns: 1fr;
    }
  }

  /* ---------------------------------------------------------------- */
  /* Partners / Instagram                                              */
  /* ---------------------------------------------------------------- */
  .partners {
    padding-block: var(--space-section);
  }

  .partners__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: clamp(32px, 5vw, 56px);
  }

  .partners__block {
    padding: clamp(28px, 4vw, 40px);
    background: var(--color-bg-alt);
  }

  .partners__heading {
    margin-bottom: 14px;
  }

  .partners__body {
    max-width: 42ch;
  }

  .partners__meta {
    margin-top: 24px;
    display: flex;
    flex-wrap: wrap;
    gap: 12px 28px;
  }

  .partners__link {
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.01em;
    color: var(--color-accent-dark);
    border-bottom: 1px solid var(--color-accent);
    padding-bottom: 2px;
    transition: color 0.2s ease, border-color 0.2s ease;
  }

  .partners__link:hover {
    color: var(--color-ink);
    border-color: var(--color-ink);
  }

  @media (prefers-reduced-motion: reduce) {
    .partners__link {
      transition: none;
    }
  }

  @media (max-width: 720px) {
    .partners__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
